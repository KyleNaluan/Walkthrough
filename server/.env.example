# Copy to server/.env for local development. Never commit the real .env.
# Production values live in Vercel > Project > Settings > Environment Variables.

PORT=3001

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
